// ==============================================================================
// AlifWorld PostgreSQL & Prisma Foundations Schema
// Reference: docs/architecture/postgresql-and-prisma-foundations.md
// Invariants: Single application, BDT/poisha precision, auditability, outbox
// ==============================================================================

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------------------------------
// 1. System Configuration & Rule Versioning
// ------------------------------------------------------------------------------
/// Platform configuration parameters, financial rule versions, and feature toggles
model SystemConfig {
  id          String    @id @default(uuid())
  key         String    @unique
  value       String
  description String?
  isPublic    Boolean   @default(false)
  version     Int       @default(1)
  updatedBy   String?   @map("updated_by")
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([deletedAt])
  @@map("system_configs")
}

// ------------------------------------------------------------------------------
// 2. Health & Operational Telemetry Probes
// ------------------------------------------------------------------------------
/// Readiness and operational probe logs for system health monitoring (TTL ephemeral)
model HealthProbe {
  id        String   @id @default(uuid())
  probeType String   @map("probe_type") // "live" | "ready"
  status    String // "healthy" | "degraded" | "unhealthy"
  latencyMs Int      @map("latency_ms")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([probeType, createdAt])
  @@index([createdAt])
  @@map("health_probes")
}

// ------------------------------------------------------------------------------
// 3. Transactional Outbox Pattern
// ------------------------------------------------------------------------------
/// Guarantees at-least-once asynchronous domain event processing via BullMQ
model OutboxEvent {
  id            String    @id @default(uuid())
  eventType     String    @map("event_type")
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  payload       Json
  status        String    @default("PENDING") // PENDING, PROCESSING, PROCESSED, FAILED
  attempts      Int       @default(0)
  version       Int       @default(1)
  lastError     String?   @map("last_error")
  processedAt   DateTime? @map("processed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([aggregateType, aggregateId])
  @@index([processedAt])
  @@map("outbox_events")
}

// ------------------------------------------------------------------------------
// 4. Immutable Audit Trail
// ------------------------------------------------------------------------------
/// Security and compliance audit log for sensitive operations and state changes
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  actorRole  String?  @map("actor_role")
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([resource, resourceId])
  @@map("audit_logs")
}

// ------------------------------------------------------------------------------
// 5. User Account & Identity
// ------------------------------------------------------------------------------
/// Core user account representing customers, sellers, admins, operations, and riders
model User {
  id              String    @id @default(uuid())
  email           String?   @unique
  phone           String?   @unique
  name            String?
  avatarUrl       String?   @map("avatar_url")
  status          String    @default("ACTIVE") // ACTIVE, PENDING_VERIFICATION, SUSPENDED, DELETED
  passwordHash    String?   @map("password_hash")
  tokenVersion    Int       @default(1) @map("token_version")
  isEmailVerified Boolean   @default(false) @map("is_email_verified")
  isPhoneVerified Boolean   @default(false) @map("is_phone_verified")
  lastLoginAt     DateTime? @map("last_login_at")
  version         Int       @default(1)
  deletedAt       DateTime? @map("deleted_at")
  deletedBy       String?   @map("deleted_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  roleAssignments UserRoleAssignment[]
  ownedSellers    Seller[]             @relation("UserOwnedSellers")
  sellerStaff     SellerStaff[]
  orders          Order[]
  carts           Cart[]
  payments        Payment[]
  wallets         Wallet[]
  pointAccount    PointAccount?
  userRanks       UserRank[]
  sessions        UserSession[]
  otpTokens       OtpToken[]
  oauthAccounts   OAuthAccount[]
  addresses       UserAddress[]

  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("users")
}

// ------------------------------------------------------------------------------
// 6. Bangladesh Geography and Customer Addresses
// ------------------------------------------------------------------------------
/// Canonical Bangladesh first-level administrative division.
model GeoDivision {
  id           String   @id
  code         String   @unique
  nameEn       String   @map("name_en")
  nameBn       String   @map("name_bn")
  headquarters String
  isActive     Boolean  @default(true) @map("is_active")
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  districts GeoDistrict[]
  addresses UserAddress[]

  @@index([isActive])
  @@map("geo_divisions")
}

/// Canonical Bangladesh district belonging to a division.
model GeoDistrict {
  id               String   @id
  divisionCode     String   @map("division_code")
  nameEn           String   @map("name_en")
  nameBn           String   @map("name_bn")
  postalCodePrefix String   @map("postal_code_prefix")
  isActive         Boolean  @default(true) @map("is_active")
  version          Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  division  GeoDivision   @relation(fields: [divisionCode], references: [code], onDelete: Restrict)
  upazilas  GeoUpazila[]
  addresses UserAddress[]

  @@index([divisionCode])
  @@index([isActive])
  @@map("geo_districts")
}

/// Extensible third-level Bangladesh administrative or metropolitan thana area.
model GeoUpazila {
  id         String   @id
  districtId String   @map("district_id")
  nameEn     String   @map("name_en")
  nameBn     String   @map("name_bn")
  postalCode String?  @map("postal_code")
  level      String   @default("UPAZILA") // UPAZILA or THANA
  isActive   Boolean  @default(true) @map("is_active")
  version    Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  district  GeoDistrict   @relation(fields: [districtId], references: [id], onDelete: Restrict)
  addresses UserAddress[]

  @@index([districtId])
  @@index([isActive])
  @@map("geo_upazilas")
}

/// Customer-owned normalized delivery address. Historical orders retain their own snapshots.
model UserAddress {
  id             String    @id
  userId         String    @map("user_id")
  label          String
  recipientName  String    @map("recipient_name")
  recipientPhone String    @map("recipient_phone")
  divisionCode   String    @map("division_code")
  districtId     String    @map("district_id")
  upazilaId      String?   @map("upazila_id")
  addressLine    String    @map("address_line")
  postalCode     String?   @map("postal_code")
  isDefault      Boolean   @default(false) @map("is_default")
  version        Int       @default(1)
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  division GeoDivision @relation(fields: [divisionCode], references: [code], onDelete: Restrict)
  district GeoDistrict @relation(fields: [districtId], references: [id], onDelete: Restrict)
  upazila  GeoUpazila? @relation(fields: [upazilaId], references: [id], onDelete: Restrict)

  @@index([userId, deletedAt])
  @@index([divisionCode, districtId])
  @@map("user_addresses")
}

// ------------------------------------------------------------------------------
// 7. Role Definition
// ------------------------------------------------------------------------------
/// RBAC roles determining functional capabilities and access tiers across the platform
model Role {
  id          String    @id @default(uuid())
  code        String    @unique // SUPER_ADMIN, ADMIN, OPERATIONS, SUPPORT, FINANCE, SELLER_OWNER, SELLER_STAFF, CUSTOMER, RIDER
  name        String
  description String?
  isSystem    Boolean   @default(false) @map("is_system")
  version     Int       @default(1)
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  rolePermissions RolePermission[]
  userAssignments UserRoleAssignment[]

  @@index([isSystem])
  @@index([deletedAt])
  @@map("roles")
}

// ------------------------------------------------------------------------------
// 7. Granular Permission
// ------------------------------------------------------------------------------
/// Atomic authorization permission grants mapped to bounded contexts and operations
model Permission {
  id          String    @id @default(uuid())
  code        String    @unique // e.g. "users:read", "users:write", "sellers:verify"
  name        String
  module      String // IAM, SELLER, CATALOG, ORDER, FINANCE, SYSTEM
  description String?
  version     Int       @default(1)
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@index([module])
  @@index([deletedAt])
  @@map("permissions")
}

// ------------------------------------------------------------------------------
// 8. Role-Permission Junction
// ------------------------------------------------------------------------------
/// Associates roles with their granular permissions
model RolePermission {
  id           String    @id @default(uuid())
  roleId       String    @map("role_id")
  permissionId String    @map("permission_id")
  version      Int       @default(1)
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@index([deletedAt])
  @@map("role_permissions")
}

// ------------------------------------------------------------------------------
// 9. User Role Assignment
// ------------------------------------------------------------------------------
/// Assigns roles to users with optional multi-tenant seller scoping
model UserRoleAssignment {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  roleId     String    @map("role_id")
  sellerId   String?   @map("seller_id") // Optional tenant scoping for seller staff/owner
  assignedBy String?   @map("assigned_by")
  version    Int       @default(1)
  deletedAt  DateTime? @map("deleted_at")
  deletedBy  String?   @map("deleted_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([roleId])
  @@index([sellerId])
  @@index([deletedAt])
  @@map("user_role_assignments")
}

// ------------------------------------------------------------------------------
// 10. Multi-Vendor Merchant (Seller)
// ------------------------------------------------------------------------------
/// Registered merchant entity operating a storefront within the AlifWorld ecosystem
model Seller {
  id                 String    @id @default(uuid())
  ownerUserId        String    @map("owner_user_id")
  businessName       String    @map("business_name")
  slug               String    @unique
  tradeLicenseNumber String?   @map("trade_license_number")
  binNumber          String?   @map("bin_number") // NBR Business Identification Number
  tinNumber          String?   @map("tin_number")
  status             String    @default("DRAFT") // DRAFT, PENDING_VERIFICATION, VERIFIED, SUSPENDED, REJECTED
  rejectionReason    String?   @map("rejection_reason")
  verifiedAt         DateTime? @map("verified_at")
  verifiedBy         String?   @map("verified_by")
  version            Int       @default(1)
  deletedAt          DateTime? @map("deleted_at")
  deletedBy          String?   @map("deleted_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  owner             User                     @relation("UserOwnedSellers", fields: [ownerUserId], references: [id], onDelete: Restrict)
  staff             SellerStaff[]
  kycDocuments      SellerKycDocument[]
  settings          SellerStoreSettings?
  products          Product[]
  warehouses        Warehouse[]
  fulfillmentGroups SellerFulfillmentGroup[]
  orderItems        OrderItem[]
  cartItems         CartItem[]
  commissions       CommissionLedger[]
  settlements       SellerSettlement[]
  payouts           SellerPayout[]
  wallets           Wallet[]
  sellerRanks       UserRank[]

  @@index([ownerUserId])
  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("sellers")
}

// ------------------------------------------------------------------------------
// 11. Seller Staff Delegation
// ------------------------------------------------------------------------------
/// Delegated staff members operating within an isolated seller tenant boundary
model SellerStaff {
  id          String    @id @default(uuid())
  sellerId    String    @map("seller_id")
  userId      String    @map("user_id")
  roleCode    String    @default("SELLER_STAFF") @map("role_code") // SELLER_OWNER, SELLER_STAFF, STORE_MANAGER
  permissions String[]  @default([])
  version     Int       @default(1)
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sellerId, userId])
  @@index([userId])
  @@index([deletedAt])
  @@map("seller_staff")
}

// ------------------------------------------------------------------------------
// 12. Seller KYC Verification Documents
// ------------------------------------------------------------------------------
/// Cryptographically protected and audited KYC regulatory verification documents
model SellerKycDocument {
  id              String    @id @default(uuid())
  sellerId        String    @map("seller_id")
  documentType    String    @map("document_type") // TRADE_LICENSE, NID_FRONT, NID_BACK, BIN_CERTIFICATE, BANK_CHEQUE_LEAF, TIN_CERTIFICATE
  documentNumber  String?   @map("document_number")
  fileUrl         String    @map("file_url") // Private S3 object key (never public)
  fileSize        Int       @map("file_size")
  mimeType        String    @map("mime_type")
  status          String    @default("PENDING") // PENDING, VERIFIED, REJECTED
  rejectionReason String?   @map("rejection_reason")
  verifiedAt      DateTime? @map("verified_at")
  verifiedBy      String?   @map("verified_by")
  version         Int       @default(1)
  deletedAt       DateTime? @map("deleted_at")
  deletedBy       String?   @map("deleted_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId, documentType])
  @@index([status])
  @@index([deletedAt])
  @@map("seller_kyc_documents")
}

// ------------------------------------------------------------------------------
// 13. Seller Store Settings & Operational Profile
// ------------------------------------------------------------------------------
/// Physical store profile, pickup/return logistics addresses, and courier routing
model SellerStoreSettings {
  id              String    @id @default(uuid())
  sellerId        String    @unique @map("seller_id")
  logoUrl         String?   @map("logo_url")
  bannerUrl       String?   @map("banner_url")
  supportEmail    String?   @map("support_email")
  supportPhone    String?   @map("support_phone")
  pickupAddress   Json?     @map("pickup_address") // division, district, upazila, street
  returnAddress   Json?     @map("return_address")
  defaultCourier  String?   @map("default_courier") // PATHAO, STEADFAST, REDX, IN_HOUSE
  vacationMode    Boolean   @default(false) @map("vacation_mode")
  vacationMessage String?   @map("vacation_message")
  version         Int       @default(1)
  deletedAt       DateTime? @map("deleted_at")
  deletedBy       String?   @map("deleted_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([deletedAt])
  @@map("seller_store_settings")
}

// ------------------------------------------------------------------------------
// 14. Catalog Taxonomy Categories
// ------------------------------------------------------------------------------
/// Hierarchical category tree with self-referencing parent/child relations and NBR VAT rules
model Category {
  id             String    @id @default(uuid())
  name           String
  nameBn         String?   @map("name_bn")
  slug           String    @unique
  description    String?
  parentId       String?   @map("parent_id")
  imageUrl       String?   @map("image_url")
  icon           String?
  displayOrder   Int       @default(0) @map("display_order")
  isActive       Boolean   @default(true) @map("is_active")
  taxRatePercent Decimal   @default(0.00) @map("tax_rate_percent") @db.Decimal(5, 2) // Default NBR VAT rate (e.g. 5.00, 7.50, 15.00)
  version        Int       @default(1)
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  parent       Category?             @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[]            @relation("CategoryHierarchy")
  products     Product[]
  translations CategoryTranslation[]

  @@index([parentId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("categories")
}

// ------------------------------------------------------------------------------
// 15. Brand Authority & Registry
// ------------------------------------------------------------------------------
/// Approved brand registry for catalog categorization and trademark compliance
model Brand {
  id         String    @id @default(uuid())
  name       String
  slug       String    @unique
  logoUrl    String?   @map("logo_url")
  website    String?
  isVerified Boolean   @default(true) @map("is_verified")
  isActive   Boolean   @default(true) @map("is_active")
  version    Int       @default(1)
  deletedAt  DateTime? @map("deleted_at")
  deletedBy  String?   @map("deleted_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  products     Product[]
  translations BrandTranslation[]

  @@index([isActive])
  @@index([deletedAt])
  @@map("brands")
}

// ------------------------------------------------------------------------------
// 16. Products & Catalog Core
// ------------------------------------------------------------------------------
/// Merchant products with strict BDT integer poisha pricing and independent Product Points
model Product {
  id                   String    @id @default(uuid())
  sellerId             String    @map("seller_id")
  categoryId           String    @map("category_id")
  brandId              String?   @map("brand_id")
  title                String
  titleBn              String?   @map("title_bn")
  slug                 String    @unique
  description          String    @db.Text
  descriptionBn        String?   @map("description_bn") @db.Text
  status               String    @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, REJECTED, PUBLISHED, ARCHIVED
  basePricePoisha      BigInt    @map("base_price_poisha") // Integer minor units (1 BDT = 100 poisha)
  compareAtPricePoisha BigInt?   @map("compare_at_price_poisha") // MSRP / strikethrough price in poisha
  currency             String    @default("BDT")
  productPoint         Int       @default(0) @map("product_point") // Discrete integer Product Points (independent from price!)
  sku                  String?   @unique
  barcode              String?
  isPhysical           Boolean   @default(true) @map("is_physical")
  weightGrams          Int?      @map("weight_grams")
  warranty             String?
  tags                 String[]  @default([])
  taxRatePercent       Decimal?  @map("tax_rate_percent") @db.Decimal(5, 2) // Overrides category tax rate if specified
  version              Int       @default(1)
  deletedAt            DateTime? @map("deleted_at")
  deletedBy            String?   @map("deleted_by")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  seller       Seller               @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  category     Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand        Brand?               @relation(fields: [brandId], references: [id], onDelete: SetNull)
  variants     ProductVariant[]
  media        ProductMedia[]
  slugHistory  ProductSlugHistory[]
  translations ProductTranslation[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("products")
}

// ------------------------------------------------------------------------------
// 17. Product Variants & SKU Matrix
// ------------------------------------------------------------------------------
/// Sellable inventory variants (e.g. Color, Size, Storage) with SKU and pricing
model ProductVariant {
  id                   String    @id @default(uuid())
  productId            String    @map("product_id")
  sku                  String    @unique
  title                String
  pricePoisha          BigInt    @map("price_poisha") // Variant price in integer poisha
  compareAtPricePoisha BigInt?   @map("compare_at_price_poisha")
  productPoint         Int?      @map("product_point") // Optional variant points override
  barcode              String?
  weightGrams          Int?      @map("weight_grams")
  option1Name          String?   @map("option1_name") // e.g. "Color"
  option1Value         String?   @map("option1_value") // e.g. "Midnight Black"
  option2Name          String?   @map("option2_name") // e.g. "Storage"
  option2Value         String?   @map("option2_value") // e.g. "256GB"
  option3Name          String?   @map("option3_name") // e.g. "Size"
  option3Value         String?   @map("option3_value")
  imageUrl             String?   @map("image_url")
  isActive             Boolean   @default(true) @map("is_active")
  displayOrder         Int       @default(0) @map("display_order")
  version              Int       @default(1)
  deletedAt            DateTime? @map("deleted_at")
  deletedBy            String?   @map("deleted_by")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  product        Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockBalances  StockBalance[]
  stockMovements StockMovementLedger[]
  cartItems      CartItem[]
  orderItems     OrderItem[]

  @@index([productId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("product_variants")
}

// ------------------------------------------------------------------------------
// 18. Product Media & Gallery Assets
// ------------------------------------------------------------------------------
/// Visual assets (images, videos) associated with products and variants
model ProductMedia {
  id           String    @id @default(uuid())
  productId    String    @map("product_id")
  mediaType    String    @default("IMAGE") @map("media_type") // IMAGE, VIDEO
  url          String // S3 permanent storage URL
  altText      String?   @map("alt_text")
  altTextBn    String?   @map("alt_text_bn")
  isPrimary    Boolean   @default(false) @map("is_primary")
  displayOrder Int       @default(0) @map("display_order")
  fileSize     Int?      @map("file_size")
  mimeType     String?   @map("mime_type")
  width        Int?
  height       Int?
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, isPrimary])
  @@index([displayOrder])
  @@index([deletedAt])
  @@map("product_media")
}

// ------------------------------------------------------------------------------
// 19. Product Slug History (Preserved Public URLs)
// ------------------------------------------------------------------------------
/// Preserves SEO redirects and permalinks when product slugs are updated
model ProductSlugHistory {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  oldSlug   String   @unique @map("old_slug")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_slug_history")
}

// ------------------------------------------------------------------------------
// 20. Localized Catalog and CMS Content
// ------------------------------------------------------------------------------
/// Normalized product translations keyed by canonical locale.
model ProductTranslation {
  id          String   @id @default(uuid())
  productId   String   @map("product_id")
  locale      String
  title       String
  description String   @db.Text
  warranty    String?
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@index([locale])
  @@map("product_translations")
}

/// Normalized category translations keyed by canonical locale.
model CategoryTranslation {
  id          String   @id @default(uuid())
  categoryId  String   @map("category_id")
  locale      String
  name        String
  description String?
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@index([locale])
  @@map("category_translations")
}

/// Normalized brand translations keyed by canonical locale.
model BrandTranslation {
  id        String   @id @default(uuid())
  brandId   String   @map("brand_id")
  locale    String
  name      String
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, locale])
  @@index([locale])
  @@map("brand_translations")
}

/// Versioned, publishable CMS content container owned by an administrator.
model CmsContent {
  id          String    @id @default(uuid())
  contentType String    @map("content_type")
  slug        String    @unique
  status      String    @default("DRAFT") // DRAFT, REVIEW, PUBLISHED, ARCHIVED
  publishedAt DateTime? @map("published_at")
  publishedBy String?   @map("published_by")
  version     Int       @default(1)
  createdBy   String?   @map("created_by")
  updatedBy   String?   @map("updated_by")
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  translations CmsContentTranslation[]

  @@index([contentType, status])
  @@index([deletedAt])
  @@map("cms_contents")
}

/// Locale-specific CMS payload. Structured JSON allows page-builder blocks without schema duplication.
model CmsContentTranslation {
  id             String   @id @default(uuid())
  contentId      String   @map("content_id")
  locale         String
  title          String
  body           Json
  seoTitle       String?  @map("seo_title")
  seoDescription String?  @map("seo_description")
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  content CmsContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, locale])
  @@index([locale])
  @@map("cms_content_translations")
}

// ------------------------------------------------------------------------------
// 21. Warehouses & Fulfillment Hubs
// ------------------------------------------------------------------------------
/// Platform fulfillment centers and merchant warehouse facilities across Bangladesh
model Warehouse {
  id            String    @id @default(uuid())
  sellerId      String?   @map("seller_id") // Null for AlifWorld platform central hub
  name          String
  code          String    @unique // e.g. DHK-HUB-01, CTG-HUB-01
  division      String // DHAKA, CHITTAGONG, RAJSHAHI, KHULNA, BARISAL, SYLHET, RANGPUR, MYMENSINGH
  district      String
  upazila       String?
  addressLine   String    @map("address_line")
  postalCode    String?   @map("postal_code")
  isPlatformHub Boolean   @default(false) @map("is_platform_hub")
  isActive      Boolean   @default(true) @map("is_active")
  version       Int       @default(1)
  deletedAt     DateTime? @map("deleted_at")
  deletedBy     String?   @map("deleted_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  seller            Seller?                  @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  stockBalances     StockBalance[]
  movements         StockMovementLedger[]
  fulfillmentGroups SellerFulfillmentGroup[]

  @@index([sellerId])
  @@index([division, district])
  @@index([isActive])
  @@index([deletedAt])
  @@map("warehouses")
}

// ------------------------------------------------------------------------------
// 21. Warehouse Inventory Balances
// ------------------------------------------------------------------------------
/// Physical on-hand, reserved, damaged, and quarantined stock balances per warehouse/variant
model StockBalance {
  id                String    @id @default(uuid())
  warehouseId       String    @map("warehouse_id")
  variantId         String    @map("variant_id")
  onHand            Int       @default(0) @map("on_hand") // Physical count present in facility
  reserved          Int       @default(0) // Quantity locked in active checkout reservations
  damaged           Int       @default(0) // Broken or unfulfillable inventory
  quarantined       Int       @default(0) // Pending quality inspection or customer return RMA
  lowStockThreshold Int       @default(5) @map("low_stock_threshold")
  reorderPoint      Int       @default(10) @map("reorder_point")
  version           Int       @default(1) // Optimistic concurrency control for atomic updates
  deletedAt         DateTime? @map("deleted_at")
  deletedBy         String?   @map("deleted_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  warehouse    Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  variant      ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Restrict)
  reservations StockReservation[]
  movements    StockMovementLedger[]

  @@unique([warehouseId, variantId])
  @@index([variantId])
  @@index([warehouseId])
  @@index([deletedAt])
  @@map("stock_balances")
}

// ------------------------------------------------------------------------------
// 22. Atomic Stock Reservations
// ------------------------------------------------------------------------------
/// Time-limited atomic stock reservations during buyer checkout with deterministic expiry
model StockReservation {
  id             String    @id @default(uuid())
  stockBalanceId String    @map("stock_balance_id")
  orderId        String?   @map("order_id")
  cartId         String?   @map("cart_id")
  quantity       Int
  status         String    @default("ACTIVE") // ACTIVE, COMMITTED, RELEASED, EXPIRED
  expiresAt      DateTime  @map("expires_at") // Deterministic TTL cutoff
  committedAt    DateTime? @map("committed_at")
  releasedAt     DateTime? @map("released_at")
  version        Int       @default(1)
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  stockBalance StockBalance @relation(fields: [stockBalanceId], references: [id], onDelete: Restrict)

  @@index([stockBalanceId, status])
  @@index([expiresAt, status])
  @@index([orderId])
  @@index([cartId])
  @@map("stock_reservations")
}

// ------------------------------------------------------------------------------
// 23. Immutable Stock Movement Ledger
// ------------------------------------------------------------------------------
/// Append-only audit trail recording every inventory balance adjustment and reservation
model StockMovementLedger {
  id             String   @id @default(uuid())
  stockBalanceId String   @map("stock_balance_id")
  warehouseId    String   @map("warehouse_id")
  variantId      String   @map("variant_id")
  movementType   String   @map("movement_type") // RECEIVE, RESERVE, RELEASE, COMMIT, ADJUST, RETURN, DAMAGE, WRITE_OFF
  quantityDelta  Int      @map("quantity_delta") // Signed delta (+/-)
  onHandAfter    Int      @map("on_hand_after")
  reservedAfter  Int      @map("reserved_after")
  availableAfter Int      @map("available_after")
  sourceType     String   @map("source_type") // PURCHASE_ORDER, CHECKOUT_RESERVATION, ORDER_FULFILLMENT, RETURN_RMA, AUDIT_ADJUSTMENT
  sourceId       String   @map("source_id")
  actorId        String?  @map("actor_id")
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at")

  stockBalance StockBalance   @relation(fields: [stockBalanceId], references: [id], onDelete: Restrict)
  warehouse    Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([variantId, warehouseId])
  @@index([stockBalanceId, createdAt])
  @@index([sourceType, sourceId])
  @@map("stock_movement_ledger")
}

// ------------------------------------------------------------------------------
// 24. Customer Shopping Cart & Session
// ------------------------------------------------------------------------------
/// Active or abandoned customer shopping cart and checkout session
model Cart {
  id         String    @id @default(uuid())
  userId     String?   @map("user_id") // Nullable for guest checkout sessions
  currency   String    @default("BDT")
  status     String    @default("ACTIVE") // ACTIVE, ABANDONED, CONVERTED, MERGED
  couponCode String?   @map("coupon_code")
  notes      String?
  version    Int       @default(1)
  deletedAt  DateTime? @map("deleted_at")
  deletedBy  String?   @map("deleted_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user  User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  items CartItem[]

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([deletedAt])
  @@map("carts")
}

// ------------------------------------------------------------------------------
// 25. Shopping Cart Line Items
// ------------------------------------------------------------------------------
/// Line items stored inside an active shopping cart with variant and pricing snapshots
model CartItem {
  id           String    @id @default(uuid())
  cartId       String    @map("cart_id")
  variantId    String    @map("variant_id")
  sellerId     String    @map("seller_id")
  quantity     Int
  pricePoisha  BigInt    @map("price_poisha") // Snapshot of variant price in poisha
  productPoint Int       @default(0) @map("product_point") // Discrete integer Product Points per unit
  version      Int       @default(1)
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  seller  Seller         @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  @@index([cartId])
  @@index([variantId])
  @@index([sellerId])
  @@index([deletedAt])
  @@map("cart_items")
}

// ------------------------------------------------------------------------------
// 26. Customer Parent Order
// ------------------------------------------------------------------------------
/// Customer parent order consolidating multi-vendor purchases into a unified checkout
model Order {
  id                 String    @id @default(uuid())
  orderNumber        String    @unique @map("order_number") // e.g. ORD-20260922-XXXX
  customerId         String    @map("customer_id")
  status             String    @default("PENDING_PAYMENT") // PENDING_PAYMENT, CONFIRMED, PROCESSING, PARTIALLY_SHIPPED, SHIPPED, DELIVERED, COMPLETED, CANCELLED, REFUNDED
  paymentStatus      String    @default("UNPAID") @map("payment_status") // UNPAID, AUTHORIZED, PAID, PARTIALLY_REFUNDED, REFUNDED, FAILED
  fulfillmentStatus  String    @default("UNFULFILLED") @map("fulfillment_status") // UNFULFILLED, PARTIALLY_FULFILLED, FULFILLED, RETURNED
  currency           String    @default("BDT")
  subtotalPoisha     BigInt    @map("subtotal_poisha")
  discountPoisha     BigInt    @default(0) @map("discount_poisha")
  shippingFeePoisha  BigInt    @default(0) @map("shipping_fee_poisha")
  taxPoisha          BigInt    @default(0) @map("tax_poisha")
  totalPoisha        BigInt    @map("total_poisha")
  totalProductPoints Int       @default(0) @map("total_product_points") // Discrete integer points total
  pointsReleased     Boolean   @default(false) @map("points_released")
  pointsReleasedAt   DateTime? @map("points_released_at")
  shippingName       String    @map("shipping_name")
  shippingPhone      String    @map("shipping_phone")
  shippingDivision   String    @map("shipping_division") // DHAKA, CHITTAGONG, etc.
  shippingDistrict   String    @map("shipping_district")
  shippingUpazila    String?   @map("shipping_upazila")
  shippingAddress    String    @map("shipping_address")
  shippingPostalCode String?   @map("shipping_postal_code")
  billingAddress     String?   @map("billing_address")
  ruleVersion        String    @default("v1.0.0") @map("rule_version") // Locked rule version applied
  customerNotes      String?   @map("customer_notes")
  adminNotes         String?   @map("admin_notes")
  cancelReason       String?   @map("cancel_reason")
  cancelledAt        DateTime? @map("cancelled_at")
  confirmedAt        DateTime? @map("confirmed_at")
  completedAt        DateTime? @map("completed_at")
  version            Int       @default(1)
  deletedAt          DateTime? @map("deleted_at")
  deletedBy          String?   @map("deleted_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  customer          User                     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items             OrderItem[]
  fulfillmentGroups SellerFulfillmentGroup[]
  statusHistory     OrderStatusHistory[]
  payments          Payment[]
  refunds           Refund[]
  commissions       CommissionLedger[]

  @@index([customerId, status])
  @@index([orderNumber])
  @@index([status, createdAt])
  @@index([paymentStatus])
  @@index([shippingDivision, shippingDistrict])
  @@index([deletedAt])
  @@map("orders")
}

// ------------------------------------------------------------------------------
// 27. Multi-Vendor Seller Fulfillment Group
// ------------------------------------------------------------------------------
/// Merchant-scoped fulfillment partition ensuring tenant isolation (merchants see only their group)
model SellerFulfillmentGroup {
  id                     String    @id @default(uuid())
  orderId                String    @map("order_id")
  sellerId               String    @map("seller_id")
  warehouseId            String?   @map("warehouse_id")
  groupNumber            String    @unique @map("group_number") // e.g. SFG-20260922-XXXX-SEL01
  status                 String    @default("PENDING") // PENDING, ACCEPTED, PACKING, READY_FOR_PICKUP, HANDED_OVER_TO_COURIER, IN_TRANSIT, DELIVERED, CANCELLED, REJECTED
  subtotalPoisha         BigInt    @map("subtotal_poisha")
  shippingFeePoisha      BigInt    @default(0) @map("shipping_fee_poisha")
  taxPoisha              BigInt    @default(0) @map("tax_poisha")
  totalPoisha            BigInt    @map("total_poisha")
  sellerCommissionPoisha BigInt    @default(0) @map("seller_commission_poisha")
  sellerPayoutPoisha     BigInt    @default(0) @map("seller_payout_poisha")
  totalProductPoints     Int       @default(0) @map("total_product_points")
  courierProvider        String?   @map("courier_provider") // PATHAO, STEADFAST, PAPERFLY, REDX, IN_HOUSE
  trackingNumber         String?   @map("tracking_number")
  consignmentId          String?   @map("consignment_id")
  pickupDate             DateTime? @map("pickup_date")
  estimatedDelivery      DateTime? @map("estimated_delivery")
  deliveredAt            DateTime? @map("delivered_at")
  version                Int       @default(1)
  deletedAt              DateTime? @map("deleted_at")
  deletedBy              String?   @map("deleted_by")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  order       Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller      Seller             @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  warehouse   Warehouse?         @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  items       OrderItem[]
  shipments   Shipment[]
  refunds     Refund[]
  commissions CommissionLedger[]

  @@index([sellerId, status])
  @@index([orderId])
  @@index([warehouseId])
  @@index([status, createdAt])
  @@index([deletedAt])
  @@map("seller_fulfillment_groups")
}

// ------------------------------------------------------------------------------
// 28. Order Line Item & Snapshot
// ------------------------------------------------------------------------------
/// Line item snapshot freezing purchased product, variant, pricing, and independent Product Points
model OrderItem {
  id                   String    @id @default(uuid())
  orderId              String    @map("order_id")
  fulfillmentGroupId   String    @map("fulfillment_group_id")
  sellerId             String    @map("seller_id")
  variantId            String    @map("variant_id")
  productTitle         String    @map("product_title")
  variantTitle         String    @map("variant_title")
  sku                  String
  unitPricePoisha      BigInt    @map("unit_price_poisha")
  quantity             Int
  totalPoisha          BigInt    @map("total_poisha")
  taxRatePercent       Decimal?  @map("tax_rate_percent") @db.Decimal(5, 2)
  taxPoisha            BigInt    @default(0) @map("tax_poisha")
  productPointSnapshot Int       @default(0) @map("product_point_snapshot") // Independent discrete points per unit
  totalProductPoints   Int       @default(0) @map("total_product_points") // productPointSnapshot * quantity
  status               String    @default("PENDING") // PENDING, CONFIRMED, PROCESSING, SHIPPED, DELIVERED, CANCELLED, RETURNED
  version              Int       @default(1)
  deletedAt            DateTime? @map("deleted_at")
  deletedBy            String?   @map("deleted_by")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  order            Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fulfillmentGroup SellerFulfillmentGroup @relation(fields: [fulfillmentGroupId], references: [id], onDelete: Cascade)
  seller           Seller                 @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  variant          ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Restrict)
  refundItems      RefundItem[]

  @@index([orderId])
  @@index([fulfillmentGroupId])
  @@index([sellerId])
  @@index([variantId])
  @@index([deletedAt])
  @@map("order_items")
}

// ------------------------------------------------------------------------------
// 29. Append-Only Order Status Audit History
// ------------------------------------------------------------------------------
/// Immutable chronological log tracking every parent order state transition
model OrderStatusHistory {
  id         String   @id @default(uuid())
  orderId    String   @map("order_id")
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  actorId    String?  @map("actor_id")
  actorRole  String?  @map("actor_role") // CUSTOMER, SELLER, ADMIN, SYSTEM
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// ------------------------------------------------------------------------------
// 30. Logistics Shipment & Courier Dispatch
// ------------------------------------------------------------------------------
/// Physical parcel package dispatched via courier service (Pathao, Steadfast, etc.)
model Shipment {
  id                 String    @id @default(uuid())
  fulfillmentGroupId String    @map("fulfillment_group_id")
  sellerId           String    @map("seller_id")
  shipmentNumber     String    @unique @map("shipment_number") // e.g. SHP-20260922-XXXX
  courierProvider    String    @map("courier_provider") // PATHAO, STEADFAST, PAPERFLY, REDX, IN_HOUSE
  trackingNumber     String?   @map("tracking_number")
  consignmentId      String?   @map("consignment_id")
  status             String    @default("PENDING") // PENDING, LABEL_CREATED, PICKED_UP, IN_TRANSIT, OUT_FOR_DELIVERY, DELIVERED, FAILED_DELIVERY, RETURNED_TO_SELLER
  weightGrams        Int?      @map("weight_grams")
  packageCount       Int       @default(1) @map("package_count")
  shippingCostPoisha BigInt    @default(0) @map("shipping_cost_poisha")
  shippedAt          DateTime? @map("shipped_at")
  deliveredAt        DateTime? @map("delivered_at")
  recipientName      String    @map("recipient_name")
  recipientPhone     String    @map("recipient_phone")
  deliveryAddress    String    @map("delivery_address")
  division           String
  district           String
  version            Int       @default(1)
  deletedAt          DateTime? @map("deleted_at")
  deletedBy          String?   @map("deleted_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  fulfillmentGroup SellerFulfillmentGroup @relation(fields: [fulfillmentGroupId], references: [id], onDelete: Cascade)
  events           ShipmentEvent[]

  @@index([fulfillmentGroupId])
  @@index([sellerId, status])
  @@index([trackingNumber])
  @@index([division, district])
  @@index([deletedAt])
  @@map("shipments")
}

// ------------------------------------------------------------------------------
// 31. Append-Only Shipment Event History
// ------------------------------------------------------------------------------
/// Immutable chronological tracking event timeline for a shipment package
model ShipmentEvent {
  id             String   @id @default(uuid())
  shipmentId     String   @map("shipment_id")
  status         String
  location       String?
  description    String
  carrierPayload Json?    @map("carrier_payload")
  occurredAt     DateTime @default(now()) @map("occurred_at")
  createdAt      DateTime @default(now()) @map("created_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
  @@map("shipment_events")
}

// ------------------------------------------------------------------------------
// 32. Customer Payment Transaction
// ------------------------------------------------------------------------------
/// Inward customer payment transaction executed through digital gateway or COD
model Payment {
  id                   String    @id @default(uuid())
  orderId              String    @map("order_id")
  customerId           String    @map("customer_id")
  paymentNumber        String    @unique @map("payment_number") // e.g. PAY-20260922-XXXX
  gatewayProvider      String    @map("gateway_provider") // BKASH, NAGAD, UPAY, ROCKET, SSLCOMMERZ, COD
  gatewayTransactionId String?   @map("gateway_transaction_id") // bKash trxID / gateway reference
  status               String    @default("PENDING") // PENDING, AUTHORIZED, CAPTURED, FAILED, CANCELLED, REFUNDED, PARTIALLY_REFUNDED
  amountPoisha         BigInt    @map("amount_poisha")
  currency             String    @default("BDT")
  feePoisha            BigInt    @default(0) @map("fee_poisha")
  clientIp             String?   @map("client_ip")
  idempotencyKey       String?   @unique @map("idempotency_key")
  gatewayPayload       Json?     @map("gateway_payload") // Sanitized provider response
  authorizedAt         DateTime? @map("authorized_at")
  capturedAt           DateTime? @map("captured_at")
  failedAt             DateTime? @map("failed_at")
  failureReason        String?   @map("failure_reason")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer User     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  refunds  Refund[]

  @@index([orderId])
  @@index([customerId])
  @@index([status, createdAt])
  @@index([gatewayProvider, gatewayTransactionId])
  @@map("payments")
}

// ------------------------------------------------------------------------------
// 33. Customer Refund Transaction
// ------------------------------------------------------------------------------
/// Full or partial refund with item-level tracking and automatic ledger reversals
model Refund {
  id                       String    @id @default(uuid())
  paymentId                String    @map("payment_id")
  orderId                  String    @map("order_id")
  fulfillmentGroupId       String?   @map("fulfillment_group_id")
  refundNumber             String    @unique @map("refund_number") // e.g. REF-20260922-XXXX
  amountPoisha             BigInt    @map("amount_poisha")
  currency                 String    @default("BDT")
  status                   String    @default("PENDING") // PENDING, APPROVED, PROCESSED, FAILED, REJECTED
  gatewayRefundId          String?   @map("gateway_refund_id")
  reason                   String // DAMAGED_GOODS, DEFECTIVE, OUT_OF_STOCK, CUSTOMER_CANCEL, FRAUD
  idempotencyKey           String?   @unique @map("idempotency_key")
  reversalPoints           Int       @default(0) @map("reversal_points") // Product Points reversed
  sellerDeductionPoisha    BigInt    @default(0) @map("seller_deduction_poisha") // Net debit against seller payout
  taxReversalPoisha        BigInt    @default(0) @map("tax_reversal_poisha")
  commissionReversalPoisha BigInt    @default(0) @map("commission_reversal_poisha")
  initiatedBy              String?   @map("initiated_by")
  approvedBy               String?   @map("approved_by")
  processedAt              DateTime? @map("processed_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  payment          Payment                 @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  order            Order                   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  fulfillmentGroup SellerFulfillmentGroup? @relation(fields: [fulfillmentGroupId], references: [id], onDelete: SetNull)
  items            RefundItem[]

  @@index([paymentId])
  @@index([orderId])
  @@index([fulfillmentGroupId])
  @@index([status, createdAt])
  @@map("refunds")
}

// ------------------------------------------------------------------------------
// 34. Item-Level Partial Refund Snapshot
// ------------------------------------------------------------------------------
/// Itemized breakdown of returned units, refund amount, and reversed Product Points
model RefundItem {
  id            String   @id @default(uuid())
  refundId      String   @map("refund_id")
  orderItemId   String   @map("order_item_id")
  quantity      Int
  amountPoisha  BigInt   @map("amount_poisha")
  taxPoisha     BigInt   @default(0) @map("tax_poisha")
  productPoints Int      @default(0) @map("product_points")
  createdAt     DateTime @default(now()) @map("created_at")

  refund    Refund    @relation(fields: [refundId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([refundId])
  @@index([orderItemId])
  @@map("refund_items")
}

// ------------------------------------------------------------------------------
// 35. Platform Commission Ledger
// ------------------------------------------------------------------------------
/// Immutable financial ledger tracking platform commissions, rule versions, and reversals
model CommissionLedger {
  id                 String   @id @default(uuid())
  sellerId           String   @map("seller_id")
  orderId            String   @map("order_id")
  fulfillmentGroupId String   @map("fulfillment_group_id")
  basisAmountPoisha  BigInt   @map("basis_amount_poisha") // Subtotal basis on which commission was calculated
  commissionRateBps  Int      @map("commission_rate_bps") // Basis points: e.g. 500 = 5.00%
  commissionPoisha   BigInt   @map("commission_poisha")
  ruleVersion        String   @default("v1.0.0") @map("rule_version") // Locked rule version applied
  status             String   @default("EARNED") // EARNED, REVERSED, SETTLED
  reversalOfId       String?  @unique @map("reversal_of_id") // Links reversal entry to original
  notes              String?
  createdAt          DateTime @default(now()) @map("created_at")

  seller             Seller                 @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  order              Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  fulfillmentGroup   SellerFulfillmentGroup @relation(fields: [fulfillmentGroupId], references: [id], onDelete: Restrict)
  originalCommission CommissionLedger?      @relation("CommissionReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversalCommission CommissionLedger?      @relation("CommissionReversal")

  @@index([sellerId, status])
  @@index([orderId])
  @@index([fulfillmentGroupId])
  @@index([createdAt])
  @@map("commission_ledger")
}

// ------------------------------------------------------------------------------
// 36. Periodic Merchant Settlement Reconciliation
// ------------------------------------------------------------------------------
/// Periodic settlement statement batch aggregating seller fulfilled orders, commissions, and adjustments
model SellerSettlement {
  id                    String    @id @default(uuid())
  sellerId              String    @map("seller_id")
  settlementNumber      String    @unique @map("settlement_number") // e.g. STL-20260922-XXXX
  periodStart           DateTime  @map("period_start")
  periodEnd             DateTime  @map("period_end")
  grossOrderPoisha      BigInt    @map("gross_order_poisha")
  shippingFeePoisha     BigInt    @map("shipping_fee_poisha")
  taxPoisha             BigInt    @map("tax_poisha")
  commissionPoisha      BigInt    @map("commission_poisha")
  refundDeductionPoisha BigInt    @default(0) @map("refund_deduction_poisha")
  netPayoutPoisha       BigInt    @map("net_payout_poisha")
  status                String    @default("PENDING") // PENDING, AUDITED, APPROVED, DISBURSED
  auditedBy             String?   @map("audited_by")
  auditedAt             DateTime? @map("audited_at")
  approvedBy            String?   @map("approved_by")
  approvedAt            DateTime? @map("approved_at")
  disbursedAt           DateTime? @map("disbursed_at")
  version               Int       @default(1)
  deletedAt             DateTime? @map("deleted_at")
  deletedBy             String?   @map("deleted_by")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  seller  Seller         @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  payouts SellerPayout[]

  @@index([sellerId, status])
  @@index([periodStart, periodEnd])
  @@index([deletedAt])
  @@map("seller_settlements")
}

// ------------------------------------------------------------------------------
// 37. Merchant Bank / MFS Wire Payout Disbursal
// ------------------------------------------------------------------------------
/// Physical electronic funds transfer (BEFTN, RTGS, bKash) disbursing net settled funds to merchant
model SellerPayout {
  id               String    @id @default(uuid())
  settlementId     String    @map("settlement_id")
  sellerId         String    @map("seller_id")
  payoutNumber     String    @unique @map("payout_number") // e.g. POT-20260922-XXXX
  channel          String // BEFTN, RTGS, NPSB, BKASH_DISBURSEMENT, NAGAD_DISBURSEMENT
  bankName         String?   @map("bank_name")
  accountNumber    String?   @map("account_number") // Masked reference (last 4 visible)
  accountTitle     String?   @map("account_title")
  routingNumber    String?   @map("routing_number")
  amountPoisha     BigInt    @map("amount_poisha")
  currency         String    @default("BDT")
  status           String    @default("PENDING") // PENDING, INITIATED, SUCCESS, FAILED, REVERSED
  gatewayReference String?   @map("gateway_reference")
  disbursedAt      DateTime? @map("disbursed_at")
  failureReason    String?   @map("failure_reason")
  version          Int       @default(1)
  deletedAt        DateTime? @map("deleted_at")
  deletedBy        String?   @map("deleted_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  settlement SellerSettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  seller     Seller           @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  @@index([settlementId])
  @@index([sellerId, status])
  @@index([channel])
  @@index([deletedAt])
  @@map("seller_payouts")
}

// ------------------------------------------------------------------------------
// 38. Gateway Webhook Ingestion & Cryptographic Verification Log
// ------------------------------------------------------------------------------
/// Idempotent webhook event log storing raw payloads, provider signatures, and replay deduplication
model PaymentWebhookLog {
  id              String    @id @default(uuid())
  gatewayProvider String    @map("gateway_provider") // BKASH, NAGAD, SSLCOMMERZ, etc.
  eventType       String    @map("event_type")
  externalEventId String?   @map("external_event_id") // Provider's unique event ID for deduplication
  signature       String?
  payload         Json
  status          String    @default("PENDING") // PENDING, VERIFIED, PROCESSED, INVALID_SIGNATURE, DUPLICATE
  processedAt     DateTime? @map("processed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([gatewayProvider, externalEventId])
  @@index([status, createdAt])
  @@map("payment_webhook_logs")
}

// ------------------------------------------------------------------------------
// 39. Multi-Account User & Merchant Wallet
// ------------------------------------------------------------------------------
/// Segregated balance wallets for customers and sellers with explicit holds
model Wallet {
  id              String    @id @default(uuid())
  userId          String?   @map("user_id")
  sellerId        String?   @map("seller_id")
  type            String // MAIN, SHOPPING, GOOD_LUCK, CHARITY, SYSTEM_RESERVE
  currency        String    @default("BDT")
  availablePoisha BigInt    @default(0) @map("available_poisha")
  pendingPoisha   BigInt    @default(0) @map("pending_poisha")
  status          String    @default("ACTIVE") // ACTIVE, FROZEN, CLOSED
  version         Int       @default(1)
  deletedAt       DateTime? @map("deleted_at")
  deletedBy       String?   @map("deleted_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user     User?           @relation(fields: [userId], references: [id], onDelete: Restrict)
  seller   Seller?         @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  postings LedgerPosting[]

  @@unique([userId, type])
  @@unique([sellerId, type])
  @@index([userId, status])
  @@index([sellerId, status])
  @@index([type, status])
  @@index([deletedAt])
  @@map("wallets")
}

// ------------------------------------------------------------------------------
// 40. Double-Entry Chart of Accounts
// ------------------------------------------------------------------------------
/// Formal chart of accounts defining double-entry asset, liability, equity, revenue, and expense categories
model LedgerAccount {
  id          String    @id @default(uuid())
  code        String    @unique // e.g. 1010-CASH-GATEWAY, 2010-CUSTOMER-MAIN-LIABILITY
  name        String
  type        String // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  currency    String    @default("BDT")
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  version     Int       @default(1)
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  postings LedgerPosting[]

  @@index([type, isActive])
  @@index([deletedAt])
  @@map("ledger_accounts")
}

// ------------------------------------------------------------------------------
// 41. Immutable Double-Entry Journal Transaction
// ------------------------------------------------------------------------------
/// Atomic, balanced financial transaction header strictly conserving Sum(Debits) == Sum(Credits)
model LedgerJournal {
  id             String   @id @default(uuid())
  journalNumber  String   @unique @map("journal_number") // e.g. JRN-20260922-XXXX
  description    String
  referenceType  String   @map("reference_type") // ORDER_PAYMENT, REWARD_DISTRIBUTION, REFUND_ADJUSTMENT, SETTLEMENT_CLEARING, WITHDRAWAL
  referenceId    String?  @map("reference_id")
  totalPoisha    BigInt   @map("total_poisha")
  idempotencyKey String?  @unique @map("idempotency_key")
  ruleVersion    String?  @map("rule_version")
  reversalOfId   String?  @unique @map("reversal_of_id")
  postedAt       DateTime @default(now()) @map("posted_at")
  createdAt      DateTime @default(now()) @map("created_at")

  originalJournal LedgerJournal?  @relation("JournalReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversalJournal LedgerJournal?  @relation("JournalReversal")
  postings        LedgerPosting[]

  @@index([referenceType, referenceId])
  @@index([postedAt])
  @@map("ledger_journals")
}

// ------------------------------------------------------------------------------
// 42. Immutable Double-Entry Ledger Posting
// ------------------------------------------------------------------------------
/// Atomic debit or credit posting against a chart of account and optional wallet
model LedgerPosting {
  id           String   @id @default(uuid())
  journalId    String   @map("journal_id")
  accountId    String   @map("account_id")
  walletId     String?  @map("wallet_id")
  direction    String // DEBIT, CREDIT
  amountPoisha BigInt   @map("amount_poisha")
  currency     String   @default("BDT")
  description  String?
  createdAt    DateTime @default(now()) @map("created_at")

  journal LedgerJournal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  account LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  wallet  Wallet?       @relation(fields: [walletId], references: [id], onDelete: SetNull)

  @@index([journalId])
  @@index([accountId])
  @@index([walletId])
  @@index([direction, createdAt])
  @@map("ledger_postings")
}

// ------------------------------------------------------------------------------
// 43. Decoupled Customer Point Account
// ------------------------------------------------------------------------------
/// Dedicated loyalty Product Point balance strictly isolated from BDT fiat balances
model PointAccount {
  id              String    @id @default(uuid())
  userId          String    @unique @map("user_id")
  availablePoints Int       @default(0) @map("available_points")
  pendingPoints   Int       @default(0) @map("pending_points") // Escrow points pending return inspection window
  lifetimePoints  Int       @default(0) @map("lifetime_points")
  version         Int       @default(1)
  deletedAt       DateTime? @map("deleted_at")
  deletedBy       String?   @map("deleted_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user   User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  events PointEvent[]

  @@index([userId])
  @@index([deletedAt])
  @@map("point_accounts")
}

// ------------------------------------------------------------------------------
// 44. Immutable Point Event Stream
// ------------------------------------------------------------------------------
/// Append-only chronological stream of loyalty token adjustments (earn, release, refund clawback)
model PointEvent {
  id             String   @id @default(uuid())
  pointAccountId String   @map("point_account_id")
  eventType      String   @map("event_type") // ORDER_EARNED, ORDER_RELEASED, REFUND_REVERSED, REWARD_AWARDED, EXPIRATION
  points         Int // Positive for credits, negative for debits/clawbacks
  orderId        String?  @map("order_id")
  orderItemId    String?  @map("order_item_id")
  ruleVersion    String   @default("v1.0.0") @map("rule_version")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")

  pointAccount PointAccount @relation(fields: [pointAccountId], references: [id], onDelete: Restrict)

  @@index([pointAccountId, createdAt])
  @@index([orderId, orderItemId])
  @@index([eventType])
  @@map("point_events")
}

// ------------------------------------------------------------------------------
// 45. Versioned Reward & Commission Split Rules
// ------------------------------------------------------------------------------
/// Versioned administrative split configuration with mandatory 100% basis point sum invariant
model RewardRule {
  id            String    @id @default(uuid())
  ruleCode      String    @map("rule_code") // CUSTOMER_REWARD_SPLIT, SELLER_CLUB_SPLIT, CUSTOMER_CASHBACK
  version       String    @default("v1.0.0")
  name          String
  description   String?
  splits        Json // Object mapping wallet targets to bps (e.g. { MAIN: 5000, SHOPPING: 2000, GOOD_LUCK: 1500, CHARITY: 500, SERVICE_CHARGE: 1000 })
  isActive      Boolean   @default(true) @map("is_active")
  effectiveFrom DateTime  @default(now()) @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  deletedAt     DateTime? @map("deleted_at")
  deletedBy     String?   @map("deleted_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  allocations RewardAllocation[]

  @@unique([ruleCode, version])
  @@index([ruleCode, isActive])
  @@index([deletedAt])
  @@map("reward_rules")
}

// ------------------------------------------------------------------------------
// 46. Immutable Reward Allocation Snapshot
// ------------------------------------------------------------------------------
/// Verifiable calculation snapshot recording reward distributions linked to double-entry journals
model RewardAllocation {
  id              String   @id @default(uuid())
  ruleId          String   @map("rule_id")
  ruleVersion     String   @map("rule_version")
  sourceType      String   @map("source_type") // ORDER, CLUB_PERIOD, RANK_BONUS
  sourceId        String   @map("source_id")
  beneficiaryType String   @map("beneficiary_type") // CUSTOMER, SELLER
  beneficiaryId   String   @map("beneficiary_id")
  basisPoisha     BigInt   @map("basis_poisha")
  allocatedPoisha BigInt   @map("allocated_poisha")
  splitBreakdown  Json     @map("split_breakdown")
  journalId       String?  @map("journal_id")
  reversalOfId    String?  @unique @map("reversal_of_id")
  createdAt       DateTime @default(now()) @map("created_at")

  rule RewardRule @relation(fields: [ruleId], references: [id], onDelete: Restrict)

  @@index([beneficiaryType, beneficiaryId])
  @@index([sourceType, sourceId])
  @@index([createdAt])
  @@map("reward_allocations")
}

// ------------------------------------------------------------------------------
// 47. Customer & Seller Rank Definitions
// ------------------------------------------------------------------------------
/// Recognition tier and star band definitions with qualification thresholds and pool shares
model RankDefinition {
  id              String    @id @default(uuid())
  category        String // CUSTOMER_CLUB, CUSTOMER_STAR, SELLER_CLUB, SELLER_STAR
  code            String // BRONZE, SILVER, GOLD, MEGA_STAR, SUPER_STAR, STAR
  title           String
  period          String // DAILY, WEEKLY, MONTHLY, YEARLY
  pointThreshold  Int?      @map("point_threshold")
  starPositionMin Int?      @map("star_position_min")
  starPositionMax Int?      @map("star_position_max")
  poolShareBps    Int?      @map("pool_share_bps") // Basis points of pool (e.g. 100 = 1%)
  effectiveFrom   DateTime  @default(now()) @map("effective_from")
  effectiveTo     DateTime? @map("effective_to")
  isActive        Boolean   @default(true) @map("is_active")
  deletedAt       DateTime? @map("deleted_at")
  deletedBy       String?   @map("deleted_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  userRanks UserRank[]

  @@unique([category, code, period])
  @@index([category, isActive])
  @@index([deletedAt])
  @@map("rank_definitions")
}

// ------------------------------------------------------------------------------
// 48. User & Seller Rank Qualification Achievements
// ------------------------------------------------------------------------------
/// Chronological log of achieved ranks per evaluation period
model UserRank {
  id                    String    @id @default(uuid())
  userId                String?   @map("user_id")
  sellerId              String?   @map("seller_id")
  rankDefinitionId      String    @map("rank_definition_id")
  period                String // DAILY, WEEKLY, MONTHLY, YEARLY
  periodDate            DateTime  @map("period_date")
  qualifyingPoints      Int       @map("qualifying_points")
  position              Int?
  rewardAllocatedPoisha BigInt    @default(0) @map("reward_allocated_poisha")
  status                String    @default("ACTIVE") // ACTIVE, EXPIRED, REVOKED
  deletedAt             DateTime? @map("deleted_at")
  deletedBy             String?   @map("deleted_by")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user           User?          @relation(fields: [userId], references: [id], onDelete: Restrict)
  seller         Seller?        @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  rankDefinition RankDefinition @relation(fields: [rankDefinitionId], references: [id], onDelete: Restrict)

  @@index([userId, rankDefinitionId])
  @@index([sellerId, rankDefinitionId])
  @@index([period, periodDate])
  @@index([deletedAt])
  @@map("user_ranks")
}

// ------------------------------------------------------------------------------
// 49. Immutable Periodic Leaderboard Ranking Snapshots
// ------------------------------------------------------------------------------
/// Historical competitive ranking leaderboard snapshots for daily, weekly, monthly, and yearly awards
model LeaderboardSnapshot {
  id                String   @id @default(uuid())
  category          String // CUSTOMER, SELLER
  period            String // DAILY, WEEKLY, MONTHLY, YEARLY
  periodStart       DateTime @map("period_start")
  periodEnd         DateTime @map("period_end")
  actorId           String   @map("actor_id")
  actorName         String   @map("actor_name")
  rankPosition      Int      @map("rank_position")
  accumulatedPoints Int      @map("accumulated_points")
  starBand          String?  @map("star_band") // MEGA_STAR, SUPER_STAR, STAR
  poolShareBps      Int?     @map("pool_share_bps")
  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([category, period, periodStart, rankPosition])
  @@index([actorId, period])
  @@index([category, period, periodStart])
  @@map("leaderboard_snapshots")
}

// ==============================================================================
// 9. IDENTITY, AUTHENTICATION & SESSIONS (Milestone 031)
// ==============================================================================

// ------------------------------------------------------------------------------
// 50. User Session & Refresh Token
// ------------------------------------------------------------------------------
/// Active authentication sessions, device metadata, and refresh token tracking
model UserSession {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  sessionToken     String    @unique @map("session_token")
  refreshTokenHash String?   @map("refresh_token_hash")
  deviceInfo       String?   @map("device_info")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  clientType       String    @default("WEB") @map("client_type") // WEB, MOBILE_FLUTTER, POS, ADMIN_PORTAL
  expiresAt        DateTime  @map("expires_at")
  lastActiveAt     DateTime  @default(now()) @map("last_active_at")
  isRevoked        Boolean   @default(false) @map("is_revoked")
  revokedAt        DateTime? @map("revoked_at")
  revokedReason    String?   @map("revoked_reason")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRevoked])
  @@index([sessionToken])
  @@index([expiresAt])
  @@map("user_sessions")
}

// ------------------------------------------------------------------------------
// 51. Ephemeral OTP & Verification Token
// ------------------------------------------------------------------------------
/// One-time verification tokens for email confirmation, phone SMS OTP, and 2FA
model OtpToken {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  identifier  String // Email address or E.164 phone (+880...)
  purpose     String // EMAIL_VERIFICATION, PHONE_VERIFICATION, PASSWORD_RESET, LOGIN_2FA
  tokenHash   String   @map("token_hash")
  attempts    Int      @default(0)
  maxAttempts Int      @default(3) @map("max_attempts")
  isUsed      Boolean  @default(false) @map("is_used")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identifier, purpose, isUsed])
  @@index([expiresAt])
  @@map("otp_tokens")
}

// ------------------------------------------------------------------------------
// 52. Federated OAuth Identities & Social Providers
// ------------------------------------------------------------------------------
/// Federated identity mappings for third-party providers (Google, Facebook, Apple)
model OAuthAccount {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  provider       String // GOOGLE, FACEBOOK, APPLE
  providerUserId String    @map("provider_user_id") // Provider's unique subject identifier (sub/id)
  email          String? // Email reported by provider at linking time
  displayName    String?   @map("display_name")
  avatarUrl      String?   @map("avatar_url")
  accessToken    String?   @map("access_token")
  refreshToken   String?   @map("refresh_token")
  expiresAt      DateTime? @map("expires_at")
  scope          String?
  metadata       Json? // Sanitized provider profile payload
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@index([email])
  @@map("oauth_accounts")
}
