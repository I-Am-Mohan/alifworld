// ==============================================================================
// AlifWorld PostgreSQL & Prisma Foundations Schema
// Reference: docs/architecture/postgresql-and-prisma-foundations.md
// Invariants: Single application, BDT/poisha precision, auditability, outbox
// ==============================================================================

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------------------------------
// 1. System Configuration & Rule Versioning
// ------------------------------------------------------------------------------
/// Platform configuration parameters, financial rule versions, and feature toggles
model SystemConfig {
  id          String    @id @default(uuid())
  key         String    @unique
  value       String
  description String?
  isPublic    Boolean   @default(false)
  version     Int       @default(1)
  updatedBy   String?   @map("updated_by")
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([deletedAt])
  @@map("system_configs")
}

// ------------------------------------------------------------------------------
// 2. Health & Operational Telemetry Probes
// ------------------------------------------------------------------------------
/// Readiness and operational probe logs for system health monitoring (TTL ephemeral)
model HealthProbe {
  id        String   @id @default(uuid())
  probeType String   @map("probe_type") // "live" | "ready"
  status    String   // "healthy" | "degraded" | "unhealthy"
  latencyMs Int      @map("latency_ms")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([probeType, createdAt])
  @@index([createdAt])
  @@map("health_probes")
}

// ------------------------------------------------------------------------------
// 3. Transactional Outbox Pattern
// ------------------------------------------------------------------------------
/// Guarantees at-least-once asynchronous domain event processing via BullMQ
model OutboxEvent {
  id            String    @id @default(uuid())
  eventType     String    @map("event_type")
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  payload       Json
  status        String    @default("PENDING") // PENDING, PROCESSING, PROCESSED, FAILED
  attempts      Int       @default(0)
  version       Int       @default(1)
  lastError     String?   @map("last_error")
  processedAt   DateTime? @map("processed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([aggregateType, aggregateId])
  @@index([processedAt])
  @@map("outbox_events")
}

// ------------------------------------------------------------------------------
// 4. Immutable Audit Trail
// ------------------------------------------------------------------------------
/// Security and compliance audit log for sensitive operations and state changes
model AuditLog {
  id          String   @id @default(uuid())
  actorId     String?  @map("actor_id")
  actorRole   String?  @map("actor_role")
  action      String
  resource    String
  resourceId  String?  @map("resource_id")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([resource, resourceId])
  @@map("audit_logs")
}

// ------------------------------------------------------------------------------
// 5. User Account & Identity
// ------------------------------------------------------------------------------
/// Core user account representing customers, sellers, admins, operations, and riders
model User {
  id              String    @id @default(uuid())
  email           String?   @unique
  phone           String?   @unique
  name            String?
  avatarUrl       String?   @map("avatar_url")
  status          String    @default("ACTIVE") // ACTIVE, PENDING_VERIFICATION, SUSPENDED, DELETED
  isEmailVerified Boolean   @default(false) @map("is_email_verified")
  isPhoneVerified Boolean   @default(false) @map("is_phone_verified")
  lastLoginAt     DateTime? @map("last_login_at")
  version         Int       @default(1)
  deletedAt       DateTime? @map("deleted_at")
  deletedBy       String?   @map("deleted_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  roleAssignments UserRoleAssignment[]

  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("users")
}

// ------------------------------------------------------------------------------
// 6. Role Definition
// ------------------------------------------------------------------------------
/// RBAC roles determining functional capabilities and access tiers across the platform
model Role {
  id          String    @id @default(uuid())
  code        String    @unique // SUPER_ADMIN, ADMIN, OPERATIONS, SUPPORT, FINANCE, SELLER_OWNER, SELLER_STAFF, CUSTOMER, RIDER
  name        String
  description String?
  isSystem    Boolean   @default(false) @map("is_system")
  version     Int       @default(1)
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  rolePermissions RolePermission[]
  userAssignments UserRoleAssignment[]

  @@index([isSystem])
  @@index([deletedAt])
  @@map("roles")
}

// ------------------------------------------------------------------------------
// 7. Granular Permission
// ------------------------------------------------------------------------------
/// Atomic authorization permission grants mapped to bounded contexts and operations
model Permission {
  id          String    @id @default(uuid())
  code        String    @unique // e.g. "users:read", "users:write", "sellers:verify"
  name        String
  module      String    // IAM, SELLER, CATALOG, ORDER, FINANCE, SYSTEM
  description String?
  version     Int       @default(1)
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@index([module])
  @@index([deletedAt])
  @@map("permissions")
}

// ------------------------------------------------------------------------------
// 8. Role-Permission Junction
// ------------------------------------------------------------------------------
/// Associates roles with their granular permissions
model RolePermission {
  id           String    @id @default(uuid())
  roleId       String    @map("role_id")
  permissionId String    @map("permission_id")
  version      Int       @default(1)
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@index([deletedAt])
  @@map("role_permissions")
}

// ------------------------------------------------------------------------------
// 9. User Role Assignment
// ------------------------------------------------------------------------------
/// Assigns roles to users with optional multi-tenant seller scoping
model UserRoleAssignment {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  roleId     String    @map("role_id")
  sellerId   String?   @map("seller_id") // Optional tenant scoping for seller staff/owner
  assignedBy String?   @map("assigned_by")
  version    Int       @default(1)
  deletedAt  DateTime? @map("deleted_at")
  deletedBy  String?   @map("deleted_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([roleId])
  @@index([sellerId])
  @@index([deletedAt])
  @@map("user_role_assignments")
}

