{
  "name": "alifworld",
  "version": "0.1.0",
  "private": true,
  "description": "AlifWorld Single-Application Modular Monolith E-Commerce Platform",
  "scripts": {
    "dev": "next dev",
    "dev:local": "next dev",
    "dev:production": "NODE_ENV=production next dev",
    "build": "next build",
    "build:local": "next build",
    "build:production": "next build",
    "start": "next start",
    "production:production": "next start -p 3000",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "quality": "bun run lint && bun run typecheck",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:e2e": "bun test tests/e2e",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "bun run prisma/seed.ts",
    "db:studio": "prisma studio",
    "worker": "bun run src/workers/index.ts",
    "openapi": "bun run scripts/generate-openapi.ts",
    "infra:up": "docker compose --profile full up -d",
    "infra:core": "docker compose --profile core up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "infra:reset": "docker compose down -v && docker compose --profile full up -d"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bullmq": "^5.14.0",
    "clsx": "^2.1.1",
    "ioredis": "^5.4.1",
    "lucide-react": "^0.446.0",
    "next": "^14.2.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "bun-types": "latest",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.13",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.12",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
