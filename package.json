{
  "name": "alifworld",
  "version": "0.1.0",
  "private": true,
  "description": "AlifWorld Single-Application Modular Monolith E-Commerce Platform",
  "scripts": {
    "dev": "bun run scripts/run-with-env.ts next dev",
    "dev:production": "bun run scripts/run-with-env.ts next dev",
    "build": "bun run scripts/run-with-env.ts next build",
    "build:local": "bun run scripts/run-with-env.ts next build",
    "build:dev": "bun run scripts/run-with-env.ts next build",
    "start": "bun run scripts/run-with-env.ts next start",
    "production:production": "bun run start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "quality": "bun run lint && bun run typecheck",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:e2e": "bun test tests/e2e",
    "db:generate": "bun run scripts/run-with-env.ts prisma generate",
    "db:migrate": "bun run scripts/run-with-env.ts prisma migrate dev",
    "db:migrate:deploy": "bun run scripts/run-with-env.ts prisma migrate deploy",
    "db:sync": "bun run scripts/run-with-env.ts prisma db push --schema prisma/schema.prisma",
    "db:sync:local": "bun run scripts/run-with-env.ts prisma db push --schema prisma/schema.prisma",
    "db:seed": "bun run scripts/run-with-env.ts bun run prisma/seed.ts",
    "seed:geo": "bun run scripts/run-with-env.ts bun run scripts/seed-bangladesh-geo.ts",
    "seed:admin": "bun run scripts/run-with-env.ts bun run scripts/seed-admin.ts",
    "db:studio": "bun run scripts/run-with-env.ts prisma studio",
    "worker": "bun run src/workers/index.ts",
    "openapi": "bun run scripts/generate-openapi.ts",
    "infra:up": "docker compose --profile full up -d",
    "infra:core": "docker compose --profile core up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "infra:reset": "docker compose down -v && docker compose --profile full up -d",
    "ci:check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run openapi && bun run build",
    "commitlint": "commitlint"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "@aws-sdk/s3-request-presigner": "^3.1138.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@scalar/api-reference-react": "^0.9.72",
    "bullmq": "^5.14.0",
    "clsx": "^2.1.1",
    "ioredis": "^5.4.1",
    "lucide-react": "^0.446.0",
    "next": "^14.2.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "bun-types": "latest",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.13",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prisma": "7.10.0",
    "tailwindcss": "^3.4.12",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
