# ==============================================================================
# AlifWorld Infrastructure Runtime Environment Configuration (.env)
# Authoritative Reference: docs/architecture/environment-branching-and-release-strategy.md
#
# NOTE: Operational platform settings (Timezone, Locales, Currencies, Storage S3/R2,
# Payment Gateways, Courier Logistics, SMS Gateways, Feature Flags) are managed
# dynamically via the Admin Operations Console (/admin/setup) and stored in PostgreSQL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV=development
APP_ENV=local
PORT=3000

# Base URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CDN_URL=https://cdn.example.com

# ------------------------------------------------------------------------------
# 2. REMOTE DATABASE (PostgreSQL & Prisma)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@remote-pg-host:5432/alifworld_db?sslmode=require"
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ------------------------------------------------------------------------------
# 3. REMOTE DISTRIBUTED CACHE, LOCKS & BULLMQ (Redis)
# ------------------------------------------------------------------------------
REDIS_URL=redis://default:password@remote-redis-host:6379/0
REDIS_KEY_PREFIX=alif:
REDIS_TLS_ENABLED=true

# ------------------------------------------------------------------------------
# 4. OBJECT STORAGE (AWS S3 or Cloudflare R2)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=AWS_S3 # AWS_S3 or CLOUDFLARE_R2

# For AWS S3:
S3_REGION=us-east-1
S3_BUCKET_NAME=alifworld-media
S3_ACCESS_KEY_ID=aws_access_key_id_here
S3_SECRET_ACCESS_KEY=aws_secret_access_key_here
S3_PUBLIC_BASE_URL=https://cdn.example.com
S3_FORCE_PATH_STYLE=false

# For Cloudflare R2 (S3 Compatible):
# R2_ACCOUNT_ID=cloudflare_account_id_here
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_BUCKET_NAME=alifworld-media
# S3_ACCESS_KEY_ID=r2_access_key_id_here
# S3_SECRET_ACCESS_KEY=r2_secret_access_key_here
# S3_PUBLIC_BASE_URL=https://pub-r2.example.com

# ------------------------------------------------------------------------------
# 6. OBSERVABILITY, LOGGING & TELEMETRY
# ------------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
