# ==============================================================================
# AlifWorld Environment Configuration Template (.env.example)
# Authoritative Reference: docs/architecture/environment-branching-and-release-strategy.md
# ==============================================================================
# NOTE: Never commit production credentials, live API keys, or secrets to Git.
# Copy this file to .env.local for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION RUNTIME
# ------------------------------------------------------------------------------
# Environment tier: 'local' | 'development' | 'staging' | 'production'
NODE_ENV=development
APP_ENV=local
PORT=3000

# Base URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CDN_URL=http://localhost:9000/alifworld-media

# Business Timezone and Locales (Locked Invariants)
TZ=Asia/Dhaka
DEFAULT_LOCALE=bn-BD
SUPPORTED_LOCALES=en-BD,bn-BD
BASE_CURRENCY=BDT

# ------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL & Prisma)
# ------------------------------------------------------------------------------
# In production, use connection pooler (e.g. PgBouncer) for DATABASE_URL
# and direct connection for DIRECT_DATABASE_URL to support schema migrations.
DATABASE_URL=postgresql://alifworld:alifworld_local_secret@localhost:5432/alifworld_dev?schema=public&connection_limit=10
DIRECT_DATABASE_URL=postgresql://alifworld:alifworld_local_secret@localhost:5432/alifworld_dev?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ------------------------------------------------------------------------------
# 3. DISTRIBUTED CACHE, LOCKS & BULLMQ (Redis)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=alif:
REDIS_TLS_ENABLED=false

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION, SESSIONS & SECURITY
# ------------------------------------------------------------------------------
# Min 32 characters random secret for JWT signing and session cookies
JWT_SECRET=change_me_to_a_secure_random_string_in_production_min_32_chars
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d
SESSION_SECRET=change_me_to_another_secure_random_string_32_chars
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Rate Limiting Parameters (Redis Token Bucket)
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX_ATTEMPTS=5
RATE_LIMIT_SMS_OTP_MAX_PER_HOUR=3

# ------------------------------------------------------------------------------
# 5. S3-COMPATIBLE OBJECT STORAGE (MinIO in local / AWS S3 in prod)
# ------------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=alifworld-media
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9000/alifworld-media

# ------------------------------------------------------------------------------
# 6. SEARCH ENGINE (Meilisearch)
# ------------------------------------------------------------------------------
# Monolith implements boot-safe fallback to PostgreSQL ILIKE if host is unavailable.
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=masterKey123
MEILISEARCH_INDEX_PREFIX=alif_

# ------------------------------------------------------------------------------
# 7. BANGLADESH MOBILE FINANCIAL SERVICES (MFS) & PAYMENT GATEWAYS
# ------------------------------------------------------------------------------
# Mock adapter active when credentials are left empty in local/dev.
# bKash Direct Checkout
BKASH_APP_KEY=mock_bkash_app_key
BKASH_APP_SECRET=mock_bkash_app_secret
BKASH_USERNAME=mock_bkash_user
BKASH_PASSWORD=mock_bkash_pass
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta

# Nagad Payment Gateway
NAGAD_MERCHANT_ID=mock_nagad_merchant
NAGAD_PUBLIC_KEY=mock_nagad_pubkey
NAGAD_PRIVATE_KEY=mock_nagad_privkey
NAGAD_BASE_URL=http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0/api/dfs

# SSLCommerz Multi-Gateway
SSLCOMMERZ_STORE_ID=mock_sslcommerz_store
SSLCOMMERZ_STORE_PASSWD=mock_sslcommerz_passwd
SSLCOMMERZ_IS_SANDBOX=true

# ------------------------------------------------------------------------------
# 8. BANGLADESH LOGISTICS & COURIER PARTNERS
# ------------------------------------------------------------------------------
PATHAO_CLIENT_ID=mock_pathao_client_id
PATHAO_CLIENT_SECRET=mock_pathao_client_secret
PATHAO_USERNAME=mock_pathao_user
PATHAO_PASSWORD=mock_pathao_pass
PATHAO_BASE_URL=https://courier-api-sandbox.pathao.com

REDX_ACCESS_TOKEN=mock_redx_token
REDX_BASE_URL=https://sandbox.redx.com.bd/v1.0.0-beta

STEADFAST_API_KEY=mock_steadfast_api_key
STEADFAST_SECRET_KEY=mock_steadfast_secret_key
STEADFAST_BASE_URL=https://portal.steadfast.com.bd/api/v1

# ------------------------------------------------------------------------------
# 9. SMS GATEWAYS (Greenweb Bangladesh & Twilio Fallback)
# ------------------------------------------------------------------------------
SMS_GATEWAY_PROVIDER=mock
GREENWEB_API_TOKEN=mock_greenweb_token
TWILIO_ACCOUNT_SID=mock_twilio_sid
TWILIO_AUTH_TOKEN=mock_twilio_token
TWILIO_PHONE_NUMBER=+1234567890

# ------------------------------------------------------------------------------
# 10. COMPLIANCE APPROVAL GATES & FEATURE FLAGS (Locked Invariants)
# ------------------------------------------------------------------------------
# GATE-01: Multi-Tier Referral Prevention (Strict single-tier enforcement (Got the License))
FEATURE_AFFILIATE_MULTI_TIER_ENABLED=true
MAX_AFFILIATE_DEPTH=1

# GATE-02: Good-Luck Lottery / Promotional Raffle Draws (Requires Legal License (Got the License))
FEATURE_LOTTERY_ENABLED=true

# GATE-03: MFS Direct Debit & Tokenization (Requires Bangladesh Bank PSO clearance (Got the License))
FEATURE_MFS_DIRECT_DEBIT_ENABLED=true

# GATE-04: NBR Automated VAT Mushak-6.3 Integration
FEATURE_NBR_TAX_INTEGRATION_ENABLED=true

# GATE-05: High-Value Maker-Checker Dual Authorization for Seller Payouts
FEATURE_MAKER_CHECKER_PAYOUT_ENABLED=true
# Threshold in Poisha: 50,000 BDT = 5,000,000 Poisha
MAKER_CHECKER_THRESHOLD_POISHA=5000000

# GATE-06: Product Points Conversion to Withdrawable Cash (Hard-locked to false)
FEATURE_POINTS_CASH_CONVERTIBLE=false

# GATE-07: Advanced Shopping Term-Deposit Products (Requires Banking License (Got the License))
FEATURE_ADVANCED_SHOPPING_ENABLED=true

# ------------------------------------------------------------------------------
# 11. OBSERVABILITY, LOGGING & TELEMETRY
# ------------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
