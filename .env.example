# ==============================================================================
# AlifWorld Infrastructure Runtime Environment Configuration (.env.example)
# Authoritative Reference: docs/architecture/environment-branching-and-release-strategy.md
#
# NOTE: Operational platform settings (Timezone, Locales, Currencies, Storage S3/R2,
# Payment Gateways, Courier Logistics, SMS Gateways, Feature Flags) are managed
# dynamically via the Admin Operations Console (/admin/setup) and stored in PostgreSQL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV=development
APP_ENV=local
PORT=3000

# Base URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CDN_URL=http://localhost:9000/alifworld-media

# ------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL & Prisma)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/alifworld_dev?schema=public&connection_limit=10"
DIRECT_DATABASE_URL="postgresql://user:password@localhost:5432/alifworld_dev?schema=public"
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ------------------------------------------------------------------------------
# 3. DISTRIBUTED CACHE, LOCKS & BULLMQ (Redis)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=alif:
REDIS_TLS_ENABLED=false

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION, SESSIONS & SECURITY
# ------------------------------------------------------------------------------
JWT_SECRET=change_me_to_a_secure_random_string_in_production_min_32_chars
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d
SESSION_SECRET=change_me_to_another_secure_random_string_32_chars
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Rate Limiting Parameters (Redis Token Bucket)
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX_ATTEMPTS=5
RATE_LIMIT_SMS_OTP_MAX_PER_HOUR=3

# ------------------------------------------------------------------------------
# 5. SEARCH ENGINE (Meilisearch)
# ------------------------------------------------------------------------------
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=masterKey123
MEILISEARCH_INDEX_PREFIX=alif_

# ------------------------------------------------------------------------------
# 6. OBSERVABILITY, LOGGING & TELEMETRY
# ------------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
